# ===== 每日新闻简报 Agent 配置 =====
# 复制这个文件为 .env 后填入真实值

# 智谱 GLM API Key（必填）
# 获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=sk-在这里填你的key

# 模型 ID（可选，默认 glm-4-flash：免费且快，短摘要 + 检索词足够）
#   glm-4-flash   默认，最快
#   glm-4-plus    质量更好、更慢更贵
#   glm-4.5-flash 思考模型，更慢，不建议
AGENT_MODEL=glm-4-flash

# 问答链路使用的模型（可选，默认与 AGENT_MODEL 相同）
AGENT_MODEL_QA=glm-4-flash

# 输出上限
AGENT_MAX_TOKENS=1200